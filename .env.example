# ==============================================================================
# CareerLens - AWS Free Tier Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. AWS Credentials & Region (Always Free: DynamoDB 25GB, Lambda 1M req/mo)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
NEXT_PUBLIC_AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ------------------------------------------------------------------------------
# 2. Amazon Cognito User Pool (Always Free: 50,000 MAUs)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. Amazon DynamoDB Tables (Provisioned Capacity: 5 RCU / 5 WCU, 25 GB free)
# ------------------------------------------------------------------------------
DYNAMODB_TABLE_USERS=CareerLens_Users
DYNAMODB_TABLE_ACTIVITIES=CareerLens_Activities
DYNAMODB_TABLE_GRAPHS=CareerLens_CareerGraphs
DYNAMODB_TABLE_COLLEGES=CareerLens_Colleges
DYNAMODB_TABLE_UPDATES=CareerLens_CareerUpdates
DYNAMODB_TABLE_MARKET_DATA=CareerLens_MarketData
DYNAMODB_TABLE_RESOURCES=CareerLens_Resources
DYNAMODB_TABLE_REVIEWS=CareerLens_Reviews

# ------------------------------------------------------------------------------
# 4. Redis & Background Jobs (Runs locally on EC2 t3.micro / t2.micro)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=super_secret_jwt_key_careerlens_change_in_production

# ------------------------------------------------------------------------------
# 5. Google AI Studio Gemini API (Free tier for LLM inference)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_GENAI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 6. External Public APIs (Search, Reddit, Maps)
# ------------------------------------------------------------------------------
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
NEWS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

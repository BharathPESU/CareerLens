# Worker Dockerfile
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source
COPY . .

# Run worker using tsx for native TS execution
CMD ["npx", "tsx", "src/lib/queue/worker.ts"]

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('ioredis').createClient(process.env.REDIS_HOST).ping()"
